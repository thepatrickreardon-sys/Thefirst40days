rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && (email() in ['thepatrickreardon@gmail.com', 'elenabox@me.com']
            || exists(/databases/$(database)/documents/admins/$(email())));
    }

    // Anyone with the link can see the schedule.
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /needs/{id}    { allow read: if true; allow write: if isAdmin(); }

    // Each helper writes only their own sign-ups; Elena/Patrick can tidy anyone's.
    match /people/{uid} {
      allow read: if true;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if (isAdmin() || (signedIn() && request.auth.uid == uid))
        && request.resource.data.keys().hasOnly(['name', 'items', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.items is list && request.resource.data.items.size() <= 200;
    }

    // Phone numbers stay private: only the person and Elena/Patrick can see them.
    match /contacts/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['phone'])
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
    }

    // Extra people who can manage the app.
    match /admins/{e} { allow read: if true; allow write: if isAdmin(); }
  }
}
